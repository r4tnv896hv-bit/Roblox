        <string name="Source"><![CDATA[-- 表示する文字の翻訳表（英語が基本。日本語の設定の人には日本語で出す）
-- 数字はクライアント側でカンマ付きの文字にしてから渡すので、整数は %s で受け取る。
local Locale = {}

local STRINGS = {
	en = {
		-- 画面
		coins_label = "Coins: %s",
		rate = "Per click +%s · Per sec +%s · Crit %s%% · x%.1f",
